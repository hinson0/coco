{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.2.3",
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@coco/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.1.28",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~55.0.14",
    "expo-audio": "~55.0.13",
    "expo-camera": "~55.0.15",
    "expo-constants": "~55.0.13",
    "expo-crypto": "~55.0.14",
    "expo-file-system": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-image": "~55.0.8",
    "expo-image-picker": "~55.0.18",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.12",
    "expo-localization": "~55.0.13",
    "expo-media-library": "~55.0.14",
    "expo-notifications": "~55.0.18",
    "expo-router": "~55.0.12",
    "expo-sharing": "~55.0.18",
    "expo-splash-screen": "~55.0.17",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-web-browser": "~55.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/uuid": "^11.0.0",
    "better-sqlite3": "^12.8.0",
    "eslint": "^10.2.0",
    "eslint-plugin-react": "^7.37.5",
    "expo-haptics": "^55.0.11",
    "globals": "^17.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.2",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "globals": {
      "ts-jest": {
        "diagnostics": false
      }
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@coco/shared$": "<rootDir>/../../packages/shared/src",
      "^expo-sqlite$": "<rootDir>/__mocks__/expo-sqlite.ts",
      "^uuid$": "<rootDir>/__mocks__/uuid.js",
      "^expo-crypto$": "<rootDir>/__mocks__/expo-crypto.ts"
    }
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "../../modules"
    }
  }
}
