{
  "workbench.colorTheme": "Default Light Modern",
  "trae.tab.enableSmartEdit": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.rulers": [80, 100],
  "editor.fontSize": 12,
  "editor.fontFamily": "Menlo, Monaco, 'Courier New', monospace",
  // =========================================================
  // ⚛️ Python
  // =========================================================
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never",
    "editor.formatOnType": true,
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.wordBasedSuggestions": "off",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "basedpyright.analysis.typeCheckingMode": "recommended",
  "editor.snippetSuggestions": "inline", //代码片段内联,在我们自己定义的变量后面.
  // =========================================================
  // ⚛️ TypeScript / JavaScript 组（Prettier）
  // =========================================================
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // =========================================================
  // 🧾 JSON / Markdown / 文档组
  // =========================================================
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "json.schemas": [],
  // ===== ESLint 配合（自动修复）=====
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
    // "source.fixAll.eslint": "explicit",
  },
  // ===== ESLint 生效语言 =====
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  // ===== 可选：提高体验 =====
  "editor.smoothScrolling": true, // cursor的动画
  "editor.cursorSmoothCaretAnimation": "on", // cursor的动画
  "explorer.autoReveal": false, // 文件不和explore跟着走
  "workbench.editor.enablePreview": false, // 不覆盖当前打开的文件.
  "editor.renderWhitespace": "all", // 显示空格为...
  "git.autofetch": true, // 自动git fetch.拉最新的信息
  "git.confirmSync": false // 以后在Push的时候不在弹框了.
}
